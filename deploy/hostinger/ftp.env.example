# Copy this file to deploy/hostinger/ftp.env (gitignored) and fill in the FTP
# account from Hostinger hPanel -> Files -> FTP Accounts.
# Never commit the real password.

HOSTINGER_FTP_HOST=ftp.yourdomain.com
HOSTINGER_FTP_PORT=21
HOSTINGER_FTP_USER=your-ftp-user
HOSTINGER_FTP_PASS=your-ftp-password

# Folder the domain serves; usually public_html.
HOSTINGER_FTP_DIR=public_html

# Hostinger expects explicit TLS on port 21; set to 0 only if your plan's FTP
# account is plain.
HOSTINGER_FTP_TLS=1
