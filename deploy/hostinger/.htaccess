# Bamania's Scanner - Apache configuration for Hostinger shared hosting.
# Upload this file next to index.html in public_html (it is already inside the
# build zip produced by deploy/hostinger/build.sh).

DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/octet-stream .apk
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories (bundles, assets, the APK) as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else renders the single page app.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Bundle and asset names are content hashed, so they can be cached for good.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|ico|webp|apk)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The shell must always be revalidated so a new build is picked up.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
