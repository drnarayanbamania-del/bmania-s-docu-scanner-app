# Supabase Configuration
# Copy this file to .env and fill in your values
# Get these from: https://supabase.com → Your Project → Settings → API

EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Disable expo-router vs react-navigation compatibility check
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# Show the upload-retry diagnostics card in Settings. Always on in development;
# set to 1 to include it in a production web export.
EXPO_PUBLIC_ENABLE_UPLOAD_DIAGNOSTICS=1
